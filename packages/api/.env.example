# MyRemote API - Environment Variables
# Copy to .env and fill with actual values

# ===========================
# Server
# ===========================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ===========================
# Database (PostgreSQL)
# ===========================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myremote
DATABASE_SSL=false
DATABASE_LOGGING=true

# ===========================
# Redis
# ===========================
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# ===========================
# Keycloak (OIDC)
# ===========================
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=myremote
KEYCLOAK_CLIENT_ID=myremote-api
KEYCLOAK_CLIENT_SECRET=your_client_secret_here

# ===========================
# JWT
# ===========================
JWT_SECRET=change_me_in_production_use_long_random_string
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# ===========================
# TURN Server
# ===========================
TURN_URL=turn:localhost:3478
TURN_SECRET=change_me_in_production
TURN_TTL=86400

# ===========================
# CORS
# ===========================
CORS_ORIGINS=http://localhost:3000,https://myremote.example.com

# ===========================
# Rate Limiting
# ===========================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ===========================
# Logging
# ===========================
LOG_LEVEL=info
LOG_FORMAT=json

# ===========================
# Vault (Optional)
# ===========================
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=myroot

# ===========================
# Monitoring
# ===========================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9091

# ===========================
# File Upload
# ===========================
MAX_FILE_SIZE=10737418240
UPLOAD_DEST=/tmp/myremote/uploads
