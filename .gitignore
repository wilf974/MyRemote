# MyRemote - .gitignore

# ===========================
# Dependencies
# ===========================
node_modules/
.pnp
.pnp.js

# ===========================
# Testing
# ===========================
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/

# ===========================
# Production Builds
# ===========================
dist/
build/
out/
.next/
.turbo/

# ===========================
# Environment Variables
# ===========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Keep .env.example files
!.env.example
!*.env.example

# ===========================
# Logs
# ===========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===========================
# OS Files
# ===========================
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ===========================
# IDE / Editors
# ===========================

# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# ===========================
# Rust (Agent)
# ===========================
packages/agent/target/
packages/agent/Cargo.lock
packages/agent/**/*.rs.bk

# ===========================
# Next.js (Frontend)
# ===========================
.next/
out/
.vercel
.turbo

# ===========================
# NestJS (Backend)
# ===========================
dist/
.nest-cache/

# ===========================
# Database
# ===========================
*.sqlite
*.sqlite3
*.db

# PostgreSQL
postgres_data/
pgdata/

# ===========================
# Docker
# ===========================
*.pid
*.seed
*.pid.lock

# ===========================
# Temporary Files
# ===========================
tmp/
temp/
*.tmp
*.bak
*.swp
*.cache

# ===========================
# Package Managers
# ===========================
.pnpm-store/
.pnpm-debug.log

# ===========================
# Certificates (Dev)
# ===========================
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

# Keep example certificates
!example.pem
!*.example.key

# ===========================
# Secrets & Credentials
# ===========================
secrets/
.secrets/
credentials.json
service-account.json

# ===========================
# Monitoring & Observability
# ===========================
prometheus_data/
grafana_data/
loki_data/

# ===========================
# Misc
# ===========================
.turbo
.cache/
.parcel-cache/
storybook-static/

# ===========================
# Documentation Generated
# ===========================
docs/api-generated/
typedoc/

# ===========================
# Platform Specific
# ===========================

# macOS
.AppleDouble
.LSOverride
._*

# Windows
ehthumbs.db
ehthumbs_vista.db

# Linux
.directory
.Trash-*

# ===========================
# Optional npm cache directory
# ===========================
.npm

# ===========================
# Optional eslint cache
# ===========================
.eslintcache

# ===========================
# Optional REPL history
# ===========================
.node_repl_history

# ===========================
# Yarn Integrity file
# ===========================
.yarn-integrity

# ===========================
# Local Workspace
# ===========================
.workspace/
workspace.code-workspace
