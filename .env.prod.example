# MyRemote - Production Environment Variables
# Copy to .env.prod and fill with actual values
# ⚠️  NEVER commit .env.prod to git!

# ===========================
# Domain Configuration
# ===========================
DOMAIN=myremote.woutils.com

# ===========================
# PostgreSQL Database
# ===========================
POSTGRES_DB=myremote
POSTGRES_USER=myremote
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ===========================
# Redis
# ===========================
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ===========================
# Keycloak (OIDC + 2FA)
# ===========================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_GENERATE_WITH_KEYCLOAK

# ===========================
# JWT Secrets
# ===========================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHARS
TURN_SECRET=CHANGE_ME_GENERATE_RANDOM_32_CHARS

# ===========================
# Grafana
# ===========================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ===========================
# Backup Configuration
# ===========================
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=myremote-backups
BACKUP_S3_REGION=eu-west-3

# ===========================
# Email (Alerts - Optional)
# ===========================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@myremote.woutils.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@myremote.woutils.com

# ===========================
# Security
# ===========================
# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Session
SESSION_TIMEOUT_MINUTES=30
MAX_SESSION_DURATION_HOURS=8
